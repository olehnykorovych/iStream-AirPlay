<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the GitHub artifact with iStream.exe and uninstall.exe
     (built by .github/workflows/release.yml, step "Build app"). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="iStream.exe" product-name="iStream">
      <authenticode-sign />
    </pe-file>
    <pe-file path="uninstall.exe" product-name="iStream">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
